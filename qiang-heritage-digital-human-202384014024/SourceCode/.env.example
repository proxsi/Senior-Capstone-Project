# ============================================
# Environment template for the Qiang heritage Q&A system.
# Copy this file to `.env` and fill in your own credentials.
# Every value below is a placeholder; no secret is shipped with the coursework copy.
# Coursework annotation: NE2301 ShengruiDu StevenDu 杜晟瑞 202384014024.
# ============================================

# ============================================
# Neo4j settings (optional knowledge-graph loader).
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ============================================
# AI provider settings (chat, vision, embedding, web search).
# ============================================
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
VISION_MODEL=deepseek-chat

ZHIPU_API_KEY=your_zhipuai_key
ZHIPU_BASE_URL=open.bigmodel.cn
EMBEDDING_MODEL=embedding-3

QWEN_API_KEY=your_aliyun_key
QWEN_BASE_URL=dashscope.aliyuncs.com
SEARCH_MODEL=qwen-plus-latest

# iFlytek text-to-speech credentials.
XF_APP_ID=your_xfyun_app_id
XF_API_KEY=your_xfyun_api_key
XF_API_SECRET=your_xfyun_api_secret

# ============================================
# Optional external web-search key.
# ============================================
SERPER_API_KEY=your_serper_api_key

# ============================================
# PostgreSQL settings (knowledge chunks and vector storage).
# The course submission carries no live database.
# ============================================
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DATABASE=postgres

# ============================================
# Retrieval-augmented generation settings.
# ============================================
SIMILARITY_THRESHOLD=0.75
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=3
WEB_SEARCH_RESULTS=3

# ============================================
# FastAPI server settings.
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# ============================================
# Logging settings.
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/qiang_heritage.log

# ============================================
# Crawler settings.
# ============================================
CRAWLER_ENABLED=True
CRAWLER_INTERVAL=3600
CRAWLER_TARGET_URL=https://www.ihchina.cn/
